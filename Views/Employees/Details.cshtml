@model WorkSphere.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container-fluid px-4 px-lg-5 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Employee Details</h1>
            <p class="text-secondary mb-0">
                View employee information and employment status.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Employees
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">

            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle bg-primary text-white
                    d-flex align-items-center justify-content-center"
                     style="width:64px;height:64px;font-size:24px;">
                    @(string.IsNullOrWhiteSpace(Model.FullName)
                        ? "?"
                        : Model.FullName.Substring(0, 1).ToUpper())
                </div>

                <div>
                    <h2 class="h4 fw-bold mb-1">@Model.FullName</h2>
                    <div class="text-secondary">@Model.JobTitle</div>
                </div>

                <div class="ms-auto">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success fs-6">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">Inactive</span>
                    }
                </div>
            </div>

            <hr />

            <div class="row g-4 mt-2">
                <div class="col-12 col-md-6">
                    <div class="text-secondary small">Employee ID</div>
                    <div class="fw-semibold">@Model.EmployeeId</div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-secondary small">Full Name</div>
                    <div class="fw-semibold">@Model.FullName</div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-secondary small">Email</div>
                    <div class="fw-semibold">@Model.Email</div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-secondary small">Job Title</div>
                    <div class="fw-semibold">@Model.JobTitle</div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-secondary small">Department</div>
                    <div class="fw-semibold">
                        @(Model.Department?.DepartmentName ?? "Unknown")
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-secondary small">Salary</div>
                    <div class="fw-semibold">
                        @Model.Salary.ToString("C")
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-secondary small">Hire Date</div>
                    <div class="fw-semibold">
                        @Model.HireDate.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
