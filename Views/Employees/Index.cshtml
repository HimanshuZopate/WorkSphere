@model IEnumerable<WorkSphere.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid px-4 px-lg-5 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Employees</h1>
            <p class="text-secondary mb-0">Manage your WorkSphere team.</p>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-primary fs-6">
                Total: @Model.Count()
            </span>

            <a asp-controller="Employees"
               asp-action="Create"
               class="btn btn-primary">
                + Add Employee
            </a>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filters -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3 p-lg-4">
            <form asp-controller="Employees" asp-action="Index" method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-6 col-xl-4">
                        <label for="name" class="form-label fw-semibold">
                            Employee Name
                        </label>
                        <input type="text"
                               id="name"
                               name="name"
                               value="@ViewBag.Name"
                               class="form-control"
                               placeholder="Search by name..." />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <label for="departmentId" class="form-label fw-semibold">
                            Department
                        </label>
                        <select id="departmentId"
                                name="departmentId"
                                asp-items="ViewBag.Departments"
                                class="form-select">
                            <option value="">All Departments</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <label for="isActive" class="form-label fw-semibold">
                            Employee Status
                        </label>
                        <select id="isActive"
                                name="isActive"
                                class="form-select">
                            <option value="">All Employees</option>
                            <option value="true"
                                    selected="@(ViewBag.IsActive is true)">
                                Active
                            </option>
                            <option value="false"
                                    selected="@(ViewBag.IsActive is false)">
                                Inactive
                            </option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">
                                Search
                            </button>

                            <a asp-controller="Employees"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Reset
                            </a>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Employee Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="px-4 py-3">Employee</th>
                        <th class="py-3">Job Title</th>
                        <th class="py-3">Department</th>
                        <th class="py-3">Salary</th>
                        <th class="py-3">Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-secondary py-5">
                                No employees found. Try changing your filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="fw-semibold">
                                        @employee.FullName
                                    </div>
                                    <div class="text-secondary small">
                                        @employee.Email
                                    </div>
                                </td>

                                <td>@employee.JobTitle</td>
                                <td>@(employee.Department?.DepartmentName ?? "Unknown")</td>
                                <td>@employee.Salary.ToString("C")</td>

                                <td>
                                    @if (employee.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

 
   
    @{
        int currentPage = (int)ViewBag.CurrentPage;
        int totalPages = (int)ViewBag.TotalPages;
    }

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Employee pages">
            <ul class="pagination justify-content-center flex-wrap">

                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-name="@ViewBag.Name"
                       asp-route-departmentId="@ViewBag.DepartmentId"
                       asp-route-isActive="@ViewBag.IsActive"
                       asp-route-page="@(currentPage - 1)">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-name="@ViewBag.Name"
                           asp-route-departmentId="@ViewBag.DepartmentId"
                           asp-route-isActive="@ViewBag.IsActive"
                           asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-name="@ViewBag.Name"
                       asp-route-departmentId="@ViewBag.DepartmentId"
                       asp-route-isActive="@ViewBag.IsActive"
                       asp-route-page="@(currentPage + 1)">
                        Next
                    </a>
                </li>

            </ul>


        </nav>

        <p class="text-center text-secondary small">
            Page @currentPage of @totalPages
            · @ViewBag.TotalCount employees
        </p>
    }


</div >
